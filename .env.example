# Copy to .env to override the compose defaults. The defaults are throwaway local values.

# POSTGRES_USER=kyber
# POSTGRES_PASSWORD=kyber
# POSTGRES_DB=kyber

# Host port for the database. 5433 by default so it does not fight a PostgreSQL already installed.
# POSTGRES_PORT=5433
# INGESTION_PORT=8080

# key:client pairs, comma separated. Keys must be at least 16 characters.
# API_KEYS=dev-agent-key-0000000001:demo-agent,dev-dashboard-key-000001:dashboard

# Domains the analyzer treats as expected traffic. Anything else raises an alert.
# ALLOWED_DOMAINS=api.openai.com,api.anthropic.com,github.com,pypi.org,registry.npmjs.org

# Request limits. BODY_LIMIT_BYTES caps a single body. REQUEST_TIMEOUT_MS caps a whole request, and
# CONNECTION_TIMEOUT_MS closes a socket that has gone quiet, which is what stops a stalled client
# holding a connection open.
# BODY_LIMIT_BYTES=524288
# REQUEST_TIMEOUT_MS=10000
# CONNECTION_TIMEOUT_MS=15000

# LOG_LEVEL=info
